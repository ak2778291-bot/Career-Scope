# ─────────────────────────────────────────────
# Career Connect Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# MongoDB Atlas connection string
# Get from: Atlas → Connect → Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/career-connect?retryWrites=true&w=majority

# JWT signing secret — use a long random string (e.g. openssl rand -base64 64)
JWT_SECRET=replace_with_a_long_random_secret_string

# JWT expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# ─── Adzuna API ───────────────────────────────
# Register at https://developer.adzuna.com/ (free tier)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Country code for Adzuna search (gb, us, in, au, ...)
# Note: Adzuna's "in" region covers India; verify at https://developer.adzuna.com/docs/search
ADZUNA_COUNTRY=gb
# Default search term for ingestion
ADZUNA_QUERY=software engineer

# ─── RemoteOK API ────────────────────────────
# No auth required — public JSON endpoint
# Tags to ingest, comma-separated. NOTE: RemoteOK's API accepts only ONE tag per
# request, so the fetcher issues one request per tag listed here (spaced ~1s apart)
# and merges the results. Do not expect "dev,backend" to work as a single query
# parameter — passing it directly to RemoteOK matches nothing and returns zero jobs.
# Valid examples: dev / backend / javascript / react / python
REMOTEOK_TAGS=dev,backend

# ─── Frontend URL (for CORS allow-list) ───────
FRONTEND_URL=http://localhost:5173

# ─── Security ─────────────────────────────────
# Secret key for the admin ingestion endpoint (sent as X-Ingestion-Secret header by cron)
# If blank, the endpoint falls back to JWT ADMIN authorization only
INGESTION_SECRET=replace_with_a_random_secret_for_cron_trigger
